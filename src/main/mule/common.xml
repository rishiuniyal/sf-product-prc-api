	<sub-flow name="sys-api-request-sub-flow" doc:id="354b5e70-d5b3-4d98-ab38-43ebc6c18214" >
		<logger level="INFO" doc:name="INFO: start of sys api request sub flow" doc:id="8e7a8a28-60cb-4ae0-9047-9ca84effe93b" message="#[%dw 2.0&#10;output application/json skipNullOn=&quot;everywhere&quot;&#10;---&#10;{&#10;    &quot;log-message&quot;:{&#10;        &quot;message&quot;:&quot;start of sys api request sub flow&quot;,&#10;        &quot;app&quot;: app.name,&#10;        &quot;log-tracepoint&quot;: &quot;BEFORE_REQUEST&quot;,&#10;        &quot;Log-Level&quot;:&quot;INFO&quot;,&#10;        &quot;Environment&quot;: p('mule.env'),&#10;        &quot;correlationId&quot;: correlationId,&#10;        &quot;Payload&quot;: null&#10;    }&#10;}]" />
		<logger level="DEBUG" doc:name="DEBUG: start of sys api request sub flow" doc:id="e2926864-2ea1-47b4-b784-2636565fe2c9" message="#[%dw 2.0&#10;output application/json skipNullOn=&quot;everywhere&quot;&#10;---&#10;{&#10;    &quot;log-message&quot;:{&#10;        &quot;message&quot;:&quot;start of sys api request sub flow&quot;,&#10;        &quot;app&quot;: app.name,&#10;        &quot;log-tracepoint&quot;: &quot;BEFORE_REQUEST&quot;,&#10;        &quot;Log-Level&quot;:&quot;DEBUG&quot;,&#10;        &quot;Environment&quot;: p('mule.env'),&#10;        &quot;correlationId&quot;: correlationId,&#10;        &quot;Payload&quot;: write(payload,&quot;application/json&quot;)        &#10;    }&#10;}]" category="${debug.category}" />
		<until-successful maxRetries="${reconnection.attempts}" doc:name="Until Successful1" doc:id="599e5439-5950-4acb-bd0d-c566095f489b" millisBetweenRetries="${reconnection.frequency}">
			<try doc:name="Try" doc:id="ede9ca85-0fea-4c17-bc6a-0f6f947f00ed">
				<http:request method="#[vars.method]" doc:name="SF System API Request" doc:id="1ae915dc-0eb7-43ad-ac98-b4d17da5cc3a" config-ref="sf-sys-api-http-request-config" responseTimeout="${http.request.responseTimeout}" path="#[if(!isEmpty(vars.productId)) (p('http.request.path') ++ &quot;/&quot; ++ (vars.productId as String))&#10;else (p('http.request.path'))]" sendCorrelationId="ALWAYS">
				<http:headers><![CDATA[#[output application/json
---
{
	"client_id": p('http.request.clientId'),
	"client_secret": p('http.request.secret')
}]]]></http:headers>
				<http:query-params><![CDATA[#[output aplication/json
---
{
	("limit": vars.limit) if(!isEmpty(vars.limit)),
	("offset": vars.offset) if(!isEmpty(vars.offset)),
	("currencyCode": vars.currencyCode) if(!isEmpty(vars.currencyCode))
}]]]></http:query-params>
			</http:request>
				<error-handler>
					<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="de93ade3-8eb7-4e43-9585-11cd236ff27e" type="HTTP:BAD_GATEWAY, HTTP:CONNECTIVITY, HTTP:SERVICE_UNAVAILABLE">
						<logger level="ERROR" doc:name="ERROR: server error from upstream" doc:id="df6daaf0-53be-4c9f-9466-1f12111dc4f6" message="#[%dw 2.0&#10;output application/json skipNullOn=&quot;everywhere&quot;&#10;---&#10;{&#10;    &quot;log-message&quot;:{&#10;        &quot;message&quot;:&quot;server error from upstream system&quot;,&#10;        &quot;app&quot;:app.name,&#10;        &quot;log-tracepoint&quot;: &quot;AT_REQUEST&quot;,&#10;        &quot;Log-Level&quot;:&quot;INFO&quot;,&#10;        &quot;Environment&quot;: p('mule.env'),&#10;        &quot;correlationId&quot;: correlationId,&#10;        &quot;Payload&quot;: null&#10;    }&#10;}]" />
					</on-error-propagate>
					<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="e52c1667-4062-4b12-a537-56cdd0a5d01f">
						<set-variable value='#[{&#10;	"errorDescription": error.description,&#10;	"errorType": (error.errorType.namespace default "") ++ ":" ++ (error.errorType.identifier default "")&#10;	&#10;}]' doc:name="errorMessage" doc:id="fe0e1f20-edd1-4629-8c9b-ef3db1ee7d49" variableName="errorMessage" />
						<logger level="INFO" doc:name="INFO: continue non retry error" doc:id="a829c220-681f-4c6e-bbf5-fdeb133d8572" message="#[%dw 2.0&#10;output application/json skipNullOn=&quot;everywhere&quot;&#10;---&#10;{&#10;    &quot;log-message&quot;:{&#10;        &quot;message&quot;:&quot;continue non retry error&quot;,&#10;        &quot;app&quot;:app.name,&#10;        &quot;log-tracepoint&quot;: &quot;AT_REQUEST&quot;,&#10;        &quot;Log-Level&quot;:&quot;INFO&quot;,&#10;        &quot;Environment&quot;: p('mule.env'),&#10;        &quot;correlationId&quot;: correlationId,&#10;        &quot;Payload&quot;: null&#10;    }&#10;}]" />
					</on-error-continue>
				</error-handler>
			</try>
		</until-successful>
		<choice doc:name="Check for non retry errors" doc:id="cb2fdcc6-3bd0-46d3-a40b-a33e12abecc0">
			<when expression="#[!isEmpty(vars.errorMessage)]">
				<raise-error doc:name="Raise APP:ERROR" doc:id="831bd54b-0bae-43c5-952f-2f4cd467239c" type="APP:NON_RETRYABLE" description="#[vars.errorMessage.errorDescription]" />
			</when>
		</choice>
		<logger level="DEBUG" doc:name="DEBUG: end of sys api request sub flow" doc:id="a3f5c189-e966-48a6-a561-e337ee3e322d" message="#[%dw 2.0&#10;output application/json skipNullOn=&quot;everywhere&quot;&#10;---&#10;{&#10;    &quot;log-message&quot;:{&#10;        &quot;message&quot;:&quot;end of sys api request sub flow&quot;,&#10;        &quot;app&quot;: app.name,&#10;        &quot;log-tracepoint&quot;: &quot;AFTER_REQUEST&quot;,&#10;        &quot;Log-Level&quot;:&quot;DEBUG&quot;,&#10;        &quot;Environment&quot;: p('mule.env'),&#10;        &quot;correlationId&quot;: correlationId,&#10;        &quot;Payload&quot;: write(payload,&quot;application/json&quot;)        &#10;    }&#10;}]" category="${debug.category}" />
		<logger level="INFO" doc:name="INFO: end of sys api request sub flow" doc:id="33c87ce9-40c7-4562-8889-30e891ecab89" message="#[%dw 2.0&#10;output application/json skipNullOn=&quot;everywhere&quot;&#10;---&#10;{&#10;    &quot;log-message&quot;:{&#10;        &quot;message&quot;:&quot;start of sys api request sub flow&quot;,&#10;        &quot;app&quot;: app.name,&#10;        &quot;log-tracepoint&quot;: &quot;AFTER_REQUEST&quot;,&#10;        &quot;Log-Level&quot;:&quot;INFO&quot;,&#10;        &quot;Environment&quot;: p('mule.env'),&#10;        &quot;correlationId&quot;: correlationId,&#10;        &quot;Payload&quot;: null   &#10;    }&#10;}]" />
	</sub-flow>
	<sub-flow name="currency-exchange-sub-flow" doc:id="25bb4e9a-40c4-42b8-a016-8ce001e1cc62" >
