						<logger level="ERROR" doc:name="ERROR: server error from upstream" doc:id="bfc519b0-31ec-40b1-8712-0979d045107a" message="#[%dw 2.0&#10;output application/json skipNullOn=&quot;everywhere&quot;&#10;---&#10;{&#10;    &quot;log-message&quot;:{&#10;        &quot;message&quot;:&quot;server error from upstream system&quot;,&#10;        &quot;app&quot;:app.name,&#10;        &quot;log-tracepoint&quot;: &quot;AT_REQUEST&quot;,&#10;        &quot;Log-Level&quot;:&quot;INFO&quot;,&#10;        &quot;Environment&quot;: p('mule.env'),&#10;        &quot;correlationId&quot;: correlationId,&#10;        &quot;Payload&quot;: null&#10;    }&#10;}]" />
					</on-error-propagate>
					<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="c1e034bd-dbed-4ed7-a1ee-a0cbec7a921d">
						<set-variable value='#[{&#10;	"errorDescription": error.description,&#10;	"errorType": (error.errorType.namespace default "") ++ ":" ++ (error.errorType.identifier default "")&#10;	&#10;}]' doc:name="errorMessage" doc:id="3c22202f-d3cf-4d28-a307-da76b2ef87d3" variableName="errorMessage" />
						<logger level="INFO" doc:name="INFO: continue non retry error" doc:id="7c0a4206-ea0e-4a9c-b5bb-9a7a370db622" message="#[%dw 2.0&#10;output application/json skipNullOn=&quot;everywhere&quot;&#10;---&#10;{&#10;    &quot;log-message&quot;:{&#10;        &quot;message&quot;:&quot;continue non retry error&quot;,&#10;        &quot;app&quot;:app.name,&#10;        &quot;log-tracepoint&quot;: &quot;AT_REQUEST&quot;,&#10;        &quot;Log-Level&quot;:&quot;INFO&quot;,&#10;        &quot;Environment&quot;: p('mule.env'),&#10;        &quot;correlationId&quot;: correlationId,&#10;        &quot;Payload&quot;: null&#10;    }&#10;}]" />
					</on-error-continue>
				</error-handler>
			</try>
		</until-successful>
		<choice doc:name="Check for non retry errors" doc:id="669d094e-7032-4d3f-9eb6-1eadd05fd662">
			<when expression="#[!isEmpty(vars.errorMessage)]">
				<raise-error doc:name="Raise APP:ERROR" doc:id="4051e3fd-b77c-4ef4-bd17-8ad72861bc11" type="APP:NON_RETRYABLE" description="#[vars.errorMessage.errorDescription]" />
			</when>
		</choice>
		<logger level="DEBUG" doc:name="DEBUG: end of currency exchange sub flow" doc:id="1e127a0e-959f-4a73-8dd6-c3d019b06350" message="#[%dw 2.0&#10;output application/json skipNullOn=&quot;everywhere&quot;&#10;---&#10;{&#10;    &quot;log-message&quot;:{&#10;        &quot;message&quot;:&quot;end of fetch records sub flow&quot;,&#10;        &quot;log-tracepoint&quot;: &quot;AFTER_REQUEST&quot;,&#10;        &quot;Log-Level&quot;:&quot;DEBUG&quot;,&#10;        &quot;Environment&quot;: p('mule.env'),&#10;        &quot;correlationId&quot;: correlationId,&#10;        &quot;Payload&quot;: write(payload,&quot;application/json&quot;)        &#10;    }&#10;}]" category="${debug.category}" />
		<logger level="INFO" doc:name="INFO: end of currency exchange sub flow" doc:id="4fa64ae7-62b6-46cd-95bc-891881a616d3" message="#[%dw 2.0&#10;output application/json skipNullOn=&quot;everywhere&quot;&#10;---&#10;{&#10;    &quot;log-message&quot;:{&#10;        &quot;message&quot;:&quot;end of fetch records sub flow&quot;,&#10;        &quot;log-tracepoint&quot;: &quot;AFTER_REQUEST&quot;,&#10;        &quot;Log-Level&quot;:&quot;INFO&quot;,&#10;        &quot;Environment&quot;: p('mule.env'),&#10;        &quot;correlationId&quot;: correlationId,&#10;        &quot;Payload&quot;: null   &#10;    }&#10;}]" />
	</sub-flow>
