		<logger level="DEBUG" doc:name="DEBUG: start of currency exchange sub flow" doc:id="3502eeca-5adf-4774-bcc8-994b458bd7b5" message="#[%dw 2.0&#10;output application/json skipNullOn=&quot;everywhere&quot;&#10;---&#10;{&#10;    &quot;log-message&quot;:{&#10;        &quot;message&quot;:&quot;start of fetch records sub flow&quot;,&#10;        &quot;log-tracepoint&quot;: &quot;BEFORE_REQUEST&quot;,&#10;        &quot;Log-Level&quot;:&quot;DEBUG&quot;,&#10;        &quot;Environment&quot;: p('mule.env'),&#10;        &quot;correlationId&quot;: correlationId,&#10;        &quot;Payload&quot;: write(payload,&quot;application/json&quot;)        &#10;    }&#10;}]" category="${debug.category}" />
		<until-successful maxRetries="${reconnection.attempts}" doc:name="Until Successful1" doc:id="32acf5ad-29d5-4c32-a164-547791c5c8ed" millisBetweenRetries="${reconnection.frequency}">
			<try doc:name="Try" doc:id="a7344dcc-936c-4790-ba47-143f4ebf1746">
				<ee:cache doc:name="Cache" doc:id="72d5c086-1ef5-4941-83cb-65d1e192b994" cachingStrategy-ref="currency-sap-caching-config">
